---
import { demoContext, suggestedPrompts } from '../lib/agentDemo';
---

<div class="agent-demo rounded-sm border border-border bg-surface-elevated shadow-sm">
  <div class="border-b border-border bg-hero-deep px-4 py-3 md:px-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="font-display text-sm font-semibold text-white">{demoContext.organization}</p>
        <p class="text-xs text-white/60">Connected context · snapshot as of {demoContext.asOf}</p>
      </div>
      <p class="rounded-sm border border-white/20 px-2 py-1 text-xs text-white/80">Demo only — scripted replies</p>
    </div>
  </div>

  <div class="grid lg:grid-cols-[minmax(0,340px)_1fr]">
    <aside class="border-b border-border bg-surface p-4 lg:border-b-0 lg:border-r md:p-5">
      <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Data sources</h3>
      <ul class="mt-3 space-y-2">
        {
          demoContext.sources.map((src) => (
            <li class="flex items-start justify-between gap-2 text-sm">
              <span class="text-ink">{src.name}</span>
              <span class="shrink-0 text-xs text-ink-muted">{src.records}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Warehouse tables</h3>
      <ul class="mt-3 space-y-2">
        {
          demoContext.datasets.map((ds) => (
            <li class="text-sm text-ink-muted">
              <span class="font-medium text-ink">{ds.table}</span>
              <span class="block text-xs">{ds.grain} · {ds.refreshed}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">Try asking</h3>
      <ul class="mt-3 space-y-2" id="agent-suggestions">
        {
          suggestedPrompts.map((prompt) => (
            <li>
              <button
                type="button"
                class="suggestion-btn w-full rounded-sm border border-border bg-surface-elevated px-3 py-2 text-left text-xs leading-snug text-ink transition hover:border-accent hover:bg-surface"
                data-prompt={prompt}
              >
                {prompt}
              </button>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="flex min-h-[320px] flex-col md:min-h-[420px]">
      <div
        id="agent-transcript"
        class="flex flex-1 flex-col gap-3 overflow-y-auto p-4 md:p-5"
        role="log"
        aria-live="polite"
        aria-label="Demo conversation"
      >
        <div class="agent-msg agent-msg--assistant max-w-[95%] rounded-sm border border-border bg-surface px-3 py-2 text-sm leading-relaxed text-ink-muted">
          Ask anything about the <strong class="font-semibold text-ink">demo datasets</strong> on the left—late
          shipments, fill rate, exceptions, inventory, or trends. Answers are scripted for this preview.
        </div>
      </div>

      <form id="agent-form" class="border-t border-border bg-surface p-4 md:p-5">
        <label for="agent-input" class="sr-only">Your question</label>
        <div class="flex flex-col gap-2 sm:flex-row">
          <input
            id="agent-input"
            type="text"
            name="question"
            autocomplete="off"
            placeholder="e.g. What is our fill rate for warehouse B?"
            class="min-w-0 flex-1 rounded-sm border border-border bg-surface-elevated px-3 py-2.5 text-sm text-ink outline-none ring-accent focus:ring-2"
          />
          <button type="submit" class="btn-primary shrink-0 px-5 py-2.5">Ask</button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .agent-msg--user {
    align-self: flex-end;
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 8%, white);
    color: var(--color-ink);
  }

  .agent-msg--assistant {
    align-self: flex-start;
    max-width: 95%;
  }
</style>

<script>
  import { matchDemoAnswer, formatDemoReply } from '../lib/agentDemo';

  const form = document.getElementById('agent-form') as HTMLFormElement | null;
  const input = document.getElementById('agent-input') as HTMLInputElement | null;
  const transcript = document.getElementById('agent-transcript');

  function appendMessage(role: 'user' | 'assistant', html: string) {
    if (!transcript) return;
    const div = document.createElement('div');
    div.className = `agent-msg agent-msg--${role} rounded-sm border border-border px-3 py-2 text-sm leading-relaxed`;
    if (role === 'user') {
      div.textContent = html;
    } else {
      div.classList.add('text-ink-muted', 'bg-surface');
      div.innerHTML = html;
    }
    transcript.appendChild(div);
    transcript.scrollTop = transcript.scrollHeight;
  }

  function ask(question: string) {
    const trimmed = question.trim();
    if (!trimmed) return;
    appendMessage('user', trimmed);
    if (input) input.value = '';
    const reply = matchDemoAnswer(trimmed);
    window.setTimeout(() => {
      appendMessage('assistant', formatDemoReply(reply));
    }, 400);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) ask(input.value);
  });

  document.querySelectorAll<HTMLButtonElement>('.suggestion-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const prompt = btn.dataset.prompt ?? btn.textContent ?? '';
      ask(prompt);
    });
  });
</script>