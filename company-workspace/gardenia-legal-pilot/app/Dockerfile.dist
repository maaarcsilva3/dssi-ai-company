# Builds slim Linux dist for copy-out (see scripts/build-dist.sh).
# starter.db is added on the host after export (portable SQLite).
# Not used on the production server.

FROM node:20-bookworm-slim AS deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-bookworm-slim AS builder
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_BASE_PATH=/dev/gardenia-legal-pilot
RUN npm run build

FROM node:20-bookworm-slim AS assembler
WORKDIR /app
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY docker-entrypoint.dist.sh ./docker-entrypoint.sh
RUN chmod +x ./docker-entrypoint.sh

# better-sqlite3 is serverExternalPackages — ensure native module is present
COPY --from=builder /app/node_modules/better-sqlite3 /tmp/better-sqlite3
RUN mkdir -p node_modules \
  && if [ ! -d node_modules/better-sqlite3 ]; then \
       cp -a /tmp/better-sqlite3 node_modules/better-sqlite3; \
     fi \
  && rm -rf /tmp/better-sqlite3

RUN test -f server.js
RUN node -e "require('better-sqlite3')"

FROM scratch AS export
COPY --from=assembler /app /
