{
  "name": "jpafli-fmcs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "build": "npm run clean && vite build && node scripts/build-server.mjs",
    "build:docker": "BASE_PATH=/ npm run build",
    "deploy": "npm run build:docker && docker compose up -d --force-recreate",
    "start:docker": "docker compose up -d --force-recreate",
    "clean": "node -e \"const fs=require('fs');const path=require('path');const d='dist';if(!fs.existsSync(d)){fs.mkdirSync(d,{recursive:true});process.exit(0)}for(const name of fs.readdirSync(d)){if(name==='.env')continue;fs.rmSync(path.join(d,name),{recursive:true,force:true})}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "multer": "^2.0.0",
    "node-sql-parser": "^5.4.0",
    "openai": "^7.33.0",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
