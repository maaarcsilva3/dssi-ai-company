---
import { withBase } from '../lib/site';

interface Props {
  id?: string;
  showCta?: boolean;
}

const { id = 'coverage', showCta = true } = Astro.props;

const regions = [
  'Luzon (including NCR, CALABARZON, Ilocos, Cagayan Valley, Central Luzon, Bicol)',
  'Visayas (including Western, Central, and Eastern Visayas)',
  'Mindanao (including Northern, Southern, and BARMM-adjacent lanes)',
];
---

<section id={id} class="section-y bg-hero-deep text-white">
  <div class="content-max">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
          Coverage across the Philippines
        </h2>
        <p class="mt-4 text-base leading-relaxed text-white/80 md:text-lg">
          JPA Freight hauls across <strong class="text-signal-line">all regions of the Philippines</strong>.
          Tell us your origin, destination, and cargo details—we’ll align capacity and routing with
          your timeline.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-white/75" role="list">
          {
            regions.map((r) => (
              <li class="flex gap-2">
                <span class="text-signal-line" aria-hidden="true">▸</span>
                {r}
              </li>
            ))
          }
        </ul>
        {
          showCta && (
            <a href={withBase('/contact#quote')} class="btn-primary mt-8 inline-flex">
              Request a quote for your lane
            </a>
          )
        }
      </div>

      <div
        class="coverage-map rounded-sm border border-white/10 bg-map-land p-4"
        data-coverage-map
      >
        <svg
          viewBox="0 0 320 520"
          class="mx-auto w-full max-w-xs"
          role="img"
          aria-labelledby="ph-map-title"
        >
          <title id="ph-map-title">Simplified map of the Philippines showing nationwide service</title>
          <!-- Luzon -->
          <path
            class="map-region map-region-active fill-map-region-active stroke-hero-deep"
            stroke-width="2"
            d="M120 20 L200 25 L220 80 L210 140 L180 160 L150 150 L100 120 L80 70 Z"
          />
          <text x="145" y="95" fill="#0f1419" font-size="14" font-weight="700" font-family="Barlow Condensed, sans-serif">LUZON</text>
          <!-- Visayas -->
          <path
            class="map-region map-region-active fill-map-region-active stroke-hero-deep"
            stroke-width="2"
            d="M60 200 L180 190 L200 230 L170 280 L90 270 L50 240 Z"
          />
          <text x="95" y="240" fill="#0f1419" font-size="14" font-weight="700" font-family="Barlow Condensed, sans-serif">VISAYAS</text>
          <!-- Mindanao -->
          <path
            class="map-region map-region-active fill-map-region-active stroke-hero-deep"
            stroke-width="2"
            d="M80 310 L200 300 L230 380 L210 480 L120 470 L70 400 Z"
          />
          <text x="125" y="400" fill="#0f1419" font-size="14" font-weight="700" font-family="Barlow Condensed, sans-serif">MINDANAO</text>
          <!-- HQ marker -->
          <circle cx="165" cy="135" r="6" fill="#e85c2b" />
          <text x="175" y="138" fill="#f0b429" font-size="10" font-family="Outfit, sans-serif">HQ · Batangas</text>
        </svg>
        <p class="mt-3 text-center text-xs text-white/50">Illustrative coverage map—not a live routing tool</p>
      </div>
    </div>
  </div>
</section>

<script>
  const maps = document.querySelectorAll('[data-coverage-map]');
  if (maps.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    maps.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .map-region {
    opacity: 0.65;
  }

  .coverage-map.is-visible .map-region-active {
    animation: region-emphasis 0.6s ease-out forwards;
  }

  .fill-map-region-active {
    fill: var(--color-map-region-active);
  }
</style>