---
const items = [
  { value: '24/7', label: 'Operations' },
  { value: 'GPS', label: 'All units tracked' },
  { value: 'Nationwide', label: 'All PH regions' },
  { value: 'Tanauan', label: 'Batangas HQ' },
];
---

<section id="trust" class="border-y border-border bg-surface-elevated">
  <div class="content-max py-6 md:py-8">
    <ul
      class="grid grid-cols-2 gap-6 divide-border md:grid-cols-4 md:divide-x md:gap-0"
      role="list"
    >
      {
        items.map((item, i) => (
          <li
            class:list={[
              'text-center md:px-6',
              i > 0 && 'md:border-l md:border-border',
              i % 2 === 1 && 'border-l border-border pl-6 md:pl-6',
            ]}
          >
            <p class="font-display text-2xl font-bold text-ink md:text-3xl">{item.value}</p>
            <p class="mt-1 text-sm text-ink-muted">{item.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>