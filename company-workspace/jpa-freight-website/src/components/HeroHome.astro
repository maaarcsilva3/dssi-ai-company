---
import { site, withBase } from '../lib/site';
---

<section class="relative min-h-[100svh] overflow-hidden" aria-labelledby="hero-heading">
  <div class="absolute inset-0">
    <img
      src={withBase('/images/hero-1.jpg')}
      alt=""
      class="hero-bg absolute inset-0 h-full w-full object-cover"
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="hero-scrim absolute inset-0"></div>
  </div>

  <div
    class="relative z-10 mx-auto flex min-h-[100svh] max-w-6xl items-end px-5 pb-16 pt-28 lg:items-center lg:px-8 lg:pb-24 lg:pt-24"
  >
    <div class="max-w-xl lg:max-w-[36rem]">
      <div class="animate-rise">
        <img
          src={withBase('/images/logo.png')}
          alt="JPA Freight Logistics logo"
          width="280"
          height="80"
          class="h-14 w-auto sm:h-16 md:h-[4.5rem]"
        />
        <p class="mt-2 font-display text-sm font-semibold tracking-wide text-white/90 sm:text-base">
          {site.name}
        </p>
      </div>
      <h1
        id="hero-heading"
        class="animate-rise-delay-1 mt-6 font-display text-[2rem] font-extrabold uppercase leading-none tracking-tight text-white sm:text-4xl md:text-[2.75rem]"
      >
        Whatever day it is… we deliver.
      </h1>
      <p class="animate-rise-delay-2 mt-5 text-base leading-relaxed text-white/85 md:text-lg">
        Nationwide freight and hauling across the Philippines—24/7 operations, GPS on every unit,
        and a Batangas team focused on ethical, customer-first logistics.
      </p>
      <div class="animate-rise-delay-3 mt-8 flex w-full flex-col gap-3 sm:flex-row">
        <a href={site.primaryCtaHref} class="btn-primary w-full sm:w-auto">Request a quote</a>
        <a href="#tracking" class="btn-ghost-hero w-full sm:w-auto">Shipment status</a>
      </div>
    </div>
  </div>
</section>