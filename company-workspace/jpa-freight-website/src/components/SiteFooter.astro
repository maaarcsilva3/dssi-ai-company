---
import { site, navLinks, withBase } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t-2 border-signal-line/40 bg-hero-deep text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.4fr_1fr_1fr] md:px-8">
    <div>
      <div class="flex items-center gap-3">
        <img src={withBase('/images/logo-fade.png')} alt="" width="48" height="48" class="h-10 w-auto" />
        <p class="font-display text-xl font-bold tracking-wide">{site.shortName}</p>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/70">{site.tagline}</p>
      <p class="mt-2 text-sm text-white/60">{site.address}</p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Navigate</p>
      <ul class="mt-4 space-y-2 text-sm text-white/80">
        {
          navLinks.map((link) => (
            <li>
              <a class="hover:text-white" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="hover:text-white" href={site.primaryCtaHref}>
            {site.primaryCta}
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Contact</p>
      <ul class="mt-4 space-y-2 text-sm text-white/80">
        <li>
          <a class="hover:text-white" href={site.phoneTel}>
            {site.phone}
          </a>
        </li>
        <li>
          <a class="hover:text-white" href={`mailto:${site.emailSales}`}>
            {site.emailSales}
          </a>
        </li>
        <li>
          <a
            class="hover:text-white"
            href={site.facebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>
        </li>
        <li class="text-white/60">
          Office: {site.hoursOffice}
        </li>
        <li class="text-white/60">Operations: {site.hoursOps}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-white/45 md:px-8">
      © {year} {site.name}
    </p>
  </div>
</footer>