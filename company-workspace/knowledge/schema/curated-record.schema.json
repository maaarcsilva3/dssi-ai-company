{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-knowledge/curated-record",
  "title": "Curated knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "body",
    "source_ref",
    "recorded_at",
    "project",
    "category",
    "verification_status",
    "lifecycle_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string" },
    "source_ref": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Paths to raw metadata or content under knowledge/"
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "project": { "type": ["string", "null"] },
    "category": {
      "type": "string",
      "enum": [
        "CEO Profile",
        "Company Profile",
        "Projects",
        "Technical Knowledge",
        "Decisions",
        "Tasks & Commitments",
        "People & Stakeholders",
        "Lessons Learned",
        "Ideas & Opportunities",
        "Historical Events"
      ]
    },
    "verification_status": {
      "enum": ["unverified", "verified_ceo", "verified_pm", "rejected"]
    },
    "lifecycle_status": {
      "enum": ["current", "outdated", "superseded"]
    },
    "superseded_by": { "type": ["string", "null"] },
    "supersedes": { "type": ["string", "null"] },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "actor", "action"],
        "properties": {
          "at": { "type": "string" },
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}